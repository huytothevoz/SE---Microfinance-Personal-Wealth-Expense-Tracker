Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# Private sources, SQL, credentials, mail previews and dependencies.
RewriteRule ^(?:backend|database)(?:/|$) - [F,END,NC]
RewriteRule (^|/)\. - [F,END]
RewriteRule ^api/(.*)$ backend/public/index.php?route=$1 [END,QSA]
RewriteRule ^app\.html$ app.php [END]
RewriteRule ^(?:index\.html|app\.php)$ - [END]
RewriteRule ^frontend/(?:css|js|assets)/[A-Za-z0-9_./-]+\.(?:css|js|svg)$ - [END]
RewriteRule ^$ - [END]
RewriteRule . - [F,END]
