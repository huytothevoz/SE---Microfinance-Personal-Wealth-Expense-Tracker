title Bản đồ Hoạt động: Đăng ký & Xác thực Người dùng (AD01 - UC01)

skinparam style strictuml
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam swimlaneWidth same
skinparam swimlaneBorderColor #334155
skinparam swimlaneBorderThickness 1.5
skinparam swimlaneTitleFontStyle bold
skinparam swimlaneTitleFontSize 13

skinparam ActivityBorderColor #0F172A
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityFontSize 12
skinparam ActivityFontColor #0F172A
skinparam ActivityDiamondBorderColor #0F172A
skinparam ActivityDiamondBackgroundColor #FFFFFF

skinparam ArrowColor #0F172A
skinparam ArrowFontSize 11
skinparam ArrowFontColor #334155


|#F8FAFC|Người dùng (User / Guest)|
start

if (Lựa chọn thao tác?) then (Đăng ký tài khoản mới)
  :Nhập Họ tên, Email, Mật khẩu & Tiền cơ sở;
  :Bấm "Đăng ký tài khoản";

  |#F1F5F9|Hệ thống WealthFlow (System)|
  :Kiểm tra tính hợp lệ & Email duy nhất;
  if (Kiểm tra dữ liệu đăng ký?) then (Email trùng / Lỗi form)
    |#F8FAFC|Người dùng (User / Guest)|
    :Hiển thị thông báo lỗi (409 Conflict / 400);
    stop
  else (Hợp lệ)
    |#F1F5F9|Hệ thống WealthFlow (System)|
    :1. Băm mật khẩu bằng Argon2id\n2. Tạo bản ghi User mới (Status = Active)\n3. Tự động sao chép danh mục mặc định (FR13.01);
    |#F8FAFC|Người dùng (User / Guest)|
    :Hiển thị thông báo đăng ký thành công;
  endif
else (Đã có tài khoản)
endif

|#F8FAFC|Người dùng (User / Guest)|
:Nhập Email & Mật khẩu đăng nhập;
:Bấm "Đăng nhập";

|#F1F5F9|Hệ thống WealthFlow (System)|
:Đối soát thông tin & Trạng thái tài khoản;
if (Thông tin đăng nhập?) then (Sai Email hoặc Mật khẩu)
  |#F8FAFC|Người dùng (User / Guest)|
  :Hiển thị lỗi 401: "Email hoặc mật khẩu không chính xác";
  stop
else (Chính xác)
  |#F1F5F9|Hệ thống WealthFlow (System)|
  if (Trạng thái tài khoản?) then (Bị khóa bởi Admin)
    |#F8FAFC|Người dùng (User / Guest)|
    :Hiển thị lỗi 403: "Tài khoản bị khóa kèm lý do";
    stop
  else (Đang hoạt động - Active)
    |#F1F5F9|Hệ thống WealthFlow (System)|
    :1. Ký phát cặp Token JWT (Access 15m, Refresh 7d)\n2. Thiết lập HttpOnly Cookie & Ghi Auth Audit Log (BR11);
    |#F8FAFC|Người dùng (User / Guest)|
    :Chuyển hướng vào Dashboard trung tâm;
    stop
  endif
endif