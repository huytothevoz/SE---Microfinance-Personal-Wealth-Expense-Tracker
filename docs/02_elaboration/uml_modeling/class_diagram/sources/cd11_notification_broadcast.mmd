classDiagram
    direction TB

    %% ==========================================
    %% ACTORS (Tác nhân tương tác)
    %% ==========================================
    class AdminActor {
        <<Actor: Quản trị viên A02>>
        +broadcastAnnouncement(title, content, priority)
        +updateSystemConfig(key, value)
    }

    class EndUserActor {
        <<Actor: Người dùng A01>>
        +getNotifications()
        +markAsRead(notificationId)
        +markAllAsRead()
    }

    class SystemEventActor {
        <<Actor: Sự kiện nghiệp vụ nội bộ>>
        +publishBudgetAlert()
        +publishLoanDueNotice()
        +publishRecurringResult()
    }

    %% ==========================================
    %% BOUNDARY LAYER (Controllers & Workers)
    %% ==========================================
    class NotificationController {
        <<Boundary>>
        +getNotifications(userId: UUID, isRead: Boolean, page: int): ResponseEntity
        +markAsRead(notificationId: UUID): ResponseEntity
        +markAllAsRead(userId: UUID): ResponseEntity
        +getUnreadCount(userId: UUID): ResponseEntity
    }

    class AdminBroadcastController {
        <<Boundary>>
        +broadcastAnnouncement(dto: CreateAnnouncementDTO): ResponseEntity
        +getAnnouncements(page: int): ResponseEntity
        +updateSystemConfig(key: String, dto: UpdateConfigDTO): ResponseEntity
        +getSystemConfigs(): ResponseEntity
    }

    class NotificationBroadcastWorker {
        <<Boundary / Worker>>
        -notificationService: NotificationService
        +processRealtimePushQueue(): void
    }

    %% ==========================================
    %% CONTROL LAYER (Services & Ports)
    %% ==========================================
    class NotificationService {
        <<Control>>
        -notificationDAO: NotificationDAO
        +createNotification(userId: UUID, dto: CreateNotificationDTO): Notification
        +markNotificationRead(userId: UUID, notificationId: UUID): void
        +markAllNotificationsRead(userId: UUID): int
        +getUnreadNotificationsCount(userId: UUID): int
        +dispatchWebSocketAlert(notification: Notification): void
    }

    class AdminBroadcastService {
        <<Control>>
        -announcementDAO: AnnouncementDAO
        -notificationDAO: NotificationDAO
        -configDAO: SystemConfigDAO
        +broadcastToAllActiveUsers(adminId: UUID, dto: CreateAnnouncementDTO): BroadcastResultVO
        +updateConfigParameter(adminId: UUID, key: String, value: String): void
        +getSystemConfigurations(): List~SystemConfiguration~
    }

    class ISystemConfigPort {
        <<Port / Interface>>
        +getConfigValue(key: String): String
        +refreshConfigCache(): void
    }

    %% ==========================================
    %% ENTITY LAYER (Domain Entities & Value Objects)
    %% ==========================================
    class Notification {
        <<Entity>>
        -id: UUID
        -userId: UUID
        -title: String
        -content: String
        -type: NotificationType
        -priority: NotificationPriority
        -isRead: boolean
        -readAt: Timestamp
        -createdAt: Timestamp
        +markRead(): void
        +isCritical(): boolean
    }

    class SystemAnnouncement {
        <<Entity>>
        -id: UUID
        -adminId: UUID
        -title: String
        -content: String
        -priority: NotificationPriority
        -targetScope: BroadcastScope
        -sentAt: Timestamp
    }

    class SystemConfiguration {
        <<Entity>>
        -id: UUID
        -configKey: String
        -configValue: String
        -description: String
        -updatedByAdminId: UUID
        -updatedAt: Timestamp
    }

    class BroadcastResultVO {
        <<ValueObject>>
        +announcementId: UUID
        +recipientUsersCount: int
        +dispatchedAt: Timestamp
        +status: String
    }

    class NotificationType {
        <<Enumeration>>
        SYSTEM_BROADCAST
        BUDGET_WARNING
        BUDGET_EXCEEDED
        LOAN_DUE_REMINDER
        RECURRING_EXECUTED
    }

    class NotificationPriority {
        <<Enumeration>>
        INFO
        WARNING
        CRITICAL
        MAINTENANCE
    }

    class BroadcastScope {
        <<Enumeration>>
        ALL_ACTIVE_USERS
        PREMIUM_USERS
        ADMINS_ONLY
    }

    %% ==========================================
    %% DATA ACCESS LAYER (DAOs)
    %% ==========================================
    class NotificationDAO {
        <<DataAccess>>
        +save(notification: Notification): Notification
        +saveFanoutBatch(announcementId: UUID, title: String, content: String, priority: NotificationPriority): int
        +findByUserId(userId: UUID, isRead: Boolean, limit: int, offset: int): List~Notification~
        +markAsRead(notificationId: UUID): boolean
        +markAllAsRead(userId: UUID): int
        +countUnread(userId: UUID): int
    }

    class AnnouncementDAO {
        <<DataAccess>>
        +save(announcement: SystemAnnouncement): SystemAnnouncement
        +findAll(limit: int, offset: int): List~SystemAnnouncement~
    }

    class SystemConfigDAO {
        <<DataAccess>>
        +findValueByKey(key: String): Optional~String~
        +updateValue(key: String, value: String, adminId: UUID): void
        +findAll(): List~SystemConfiguration~
    }

    %% ==========================================
    %% RELATIONSHIPS
    %% ==========================================
    EndUserActor --> NotificationController : xem và đánh dấu đọc thông báo
    AdminActor --> AdminBroadcastController : phát thông cáo và cấu hình hệ thống
    SystemEventActor --> NotificationService : phát sinh sự kiện cảnh báo

    NotificationController --> NotificationService : yêu cầu nghiệp vụ thông báo
    AdminBroadcastController --> AdminBroadcastService : yêu cầu phát hành diện rộng
    NotificationBroadcastWorker --> NotificationService : đẩy thông báo WebSocket

    AdminBroadcastService --> AnnouncementDAO : lưu thông cáo quản trị
    AdminBroadcastService --> NotificationDAO : thực thi fan-out hàng loạt
    AdminBroadcastService --> SystemConfigDAO : lưu cấu hình hệ thống
    NotificationService --> NotificationDAO : lưu và đọc thông báo người dùng

    AdminBroadcastService ..> BroadcastResultVO : sinh kết quả phát thông cáo
    AdminBroadcastService ..> SystemAnnouncement : tạo thực thể thông cáo
    NotificationService ..> Notification : tạo và cập nhật thực thể

    Notification --> NotificationType : phân loại nguồn thông báo
    Notification --> NotificationPriority : cấp độ ưu tiên
    SystemAnnouncement --> BroadcastScope : phạm vi người nhận

    NotificationDAO ..> Notification : ánh xạ CSDL bảng notifications
    AnnouncementDAO ..> SystemAnnouncement : ánh xạ CSDL bảng system_announcements
    SystemConfigDAO ..> SystemConfiguration : ánh xạ CSDL bảng system_configurations

