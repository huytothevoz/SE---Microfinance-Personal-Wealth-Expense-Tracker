classDiagram
    direction TB

    %% ==========================================
    %% CORE AGGREGATES & DOMAIN ENTITIES
    %% ==========================================
    class User {
        <<Aggregate Root>>
        +UUID id
        +String email
        +String passwordHash
        +String fullName
        +String baseCurrency
        +UserRole role
        +AccountStatus status
        +Timestamp createdAt
        +validatePassword(rawPassword) boolean
        +lock(reason) void
        +unlock() void
        +isActive() boolean
    }

    class Wallet {
        <<Entity>>
        +UUID id
        +UUID userId
        +String name
        +WalletType type
        +String currency
        +BigDecimal balance
        +BigDecimal openingBalance
        +WalletStatus status
        +deposit(amount) void
        +withdraw(amount) void
        +canWithdraw(amount) boolean
        +archive() void
    }

    class Category {
        <<Entity>>
        +UUID id
        +UUID userId
        +String name
        +CategoryType type
        +String icon
        +boolean isSystemStandard
        +boolean isActive
    }

    class FinancialTransaction {
        <<Aggregate Root>>
        +UUID id
        +UUID userId
        +TransactionType type
        +TransactionStatus status
        +BigDecimal totalAmount
        +String originalCurrency
        +Date transactionDate
        +String description
        +UUID originalTransactionId
        +validateBalance() boolean
        +createReversal() FinancialTransaction
    }

    class JournalEntry {
        <<Entity>>
        +UUID id
        +UUID transactionId
        +UUID walletId
        +UUID categoryId
        +AccountType accountType
        +EntryDirection direction
        +BigDecimal amount
        +BigDecimal baseAmount
    }

    class RecurringRule {
        <<Entity>>
        +UUID id
        +UUID userId
        +UUID walletId
        +UUID categoryId
        +BigDecimal amount
        +RecurrenceFrequency frequency
        +int anchorDay
        +Date nextDueDate
        +boolean isAutoPost
        +RecurringStatus status
        +calculateNextDueDate(currentDate) Date
        +pause() void
        +resume() void
    }

    class Budget {
        <<Entity>>
        +UUID id
        +UUID userId
        +UUID categoryId
        +YearMonth month
        +BigDecimal limitAmount
        +BigDecimal spentAmount
        +BudgetAlertLevel alertLevel
        +boolean isYellowAlertSent
        +boolean isRedAlertSent
        +calculateUsage() double
        +updateSpent(newSpent) void
    }

    class Loan {
        <<Aggregate Root>>
        +UUID id
        +UUID userId
        +String title
        +String counterparty
        +LoanType loanType
        +BigDecimal principalAmount
        +BigDecimal remainingPrincipal
        +double interestRateYear
        +int termMonths
        +Date startDate
        +Date dueDate
        +LoanStatus status
        +applyRepayment(principalPaid) void
        +isPaidOff() boolean
    }

    class RepaymentScheduleItem {
        <<Entity>>
        +UUID id
        +UUID loanId
        +int periodNumber
        +Date dueDate
        +BigDecimal principalDue
        +BigDecimal interestDue
        +BigDecimal principalPaid
        +RepaymentStatus status
    }

    class GoldHolding {
        <<Aggregate Root>>
        +UUID id
        +UUID userId
        +GoldType goldType
        +BigDecimal quantityTael
        +BigDecimal totalCostBasis
        +BigDecimal weightedAvgCostPerTael
        +BigDecimal currentMarketUnitPrice
        +applyPurchase(taels, cost) void
        +applySale(taels) BigDecimal
        +getCurrentMarketValue() BigDecimal
    }

    class GoldTransaction {
        <<Entity>>
        +UUID id
        +UUID holdingId
        +GoldTxType txType
        +BigDecimal quantityTael
        +BigDecimal unitPrice
        +BigDecimal totalAmount
    }

    class FinancialGoal {
        <<Aggregate Root>>
        +UUID id
        +UUID userId
        +String goalName
        +BigDecimal targetAmount
        +BigDecimal currentAmount
        +Date targetDate
        +UUID linkedWalletId
        +GoalStatus status
        +allocate(amount) void
        +withdraw(amount) void
        +calculateProgress() double
    }

    class GoalAllocation {
        <<Entity>>
        +UUID id
        +UUID goalId
        +UUID walletId
        +AllocationType allocationType
        +BigDecimal amount
        +Timestamp allocatedAt
    }

    class NetWorthSnapshot {
        <<Entity>>
        +UUID id
        +UUID userId
        +Date snapshotDate
        +BigDecimal totalAssets
        +BigDecimal totalLiabilities
        +BigDecimal netWorth
        +calculateNetWorth() BigDecimal
    }

    class Notification {
        <<Entity>>
        +UUID id
        +UUID userId
        +String title
        +String content
        +NotificationType type
        +NotificationPriority priority
        +boolean isRead
        +markRead() void
    }

    %% ==========================================
    %% RELATIONSHIPS (DOMAIN MODEL ARCHITECTURE)
    %% ==========================================
    User "1" *-- "0..*" Wallet : sở hữu danh mục ví
    User "1" *-- "0..*" Category : quản lý danh mục thu chi
    User "1" *-- "0..*" FinancialTransaction : tạo giao dịch tài chính
    User "1" *-- "0..*" RecurringRule : thiết lập quy tắc định kỳ
    User "1" *-- "0..*" Budget : lập ngân sách tháng
    User "1" *-- "0..*" Loan : quản lý vay nợ vi mô
    User "1" *-- "0..*" GoldHolding : tích lũy vàng thị trường
    User "1" *-- "0..*" FinancialGoal : lập mục tiêu tài chính
    User "1" *-- "0..*" NetWorthSnapshot : lưu chuỗi snapshot tài sản ròng
    User "1" *-- "0..*" Notification : nhận thông báo chuông

    FinancialTransaction "1" *-- "2..*" JournalEntry : phân rã bút toán Nợ Có
    JournalEntry "0..*" --> "1" Wallet : ghi nhận biến động số dư
    JournalEntry "0..*" --> "0..1" Category : phân loại hạng mục nghiệp vụ

    RecurringRule "0..*" --> "1" Wallet : liên kết ví trích tiền
    RecurringRule "0..*" --> "1" Category : gắn danh mục định kỳ
    Budget "0..*" --> "1" Category : kiểm soát hạn mức danh mục

    Loan "1" *-- "0..*" RepaymentScheduleItem : lịch trả góp từng kỳ
    GoldHolding "1" *-- "0..*" GoldTransaction : nhật ký mua bán vàng
    FinancialGoal "1" *-- "0..*" GoalAllocation : đợt phân bổ vốn
    FinancialGoal "0..*" --> "1" Wallet : khóa tiền Earmark tại ví

