    style FinancialTransaction fill:#FEF3C7,stroke:#D97706,stroke-width:2px
    style JournalEntry fill:#FEF3C7,stroke:#D97706,stroke-width:1px
    style RecurringRule fill:#FDF2F8,stroke:#DB2777,stroke-width:1px
    style Budget fill:#F0FDF4,stroke:#16A34A,stroke-width:1px
    style Loan fill:#FFFBEB,stroke:#B45309,stroke-width:2px
    style RepaymentScheduleItem fill:#FFFBEB,stroke:#B45309,stroke-width:1px
    style GoldHolding fill:#FEF9C3,stroke:#CA8A04,stroke-width:2px
    style GoldTransaction fill:#FEF9C3,stroke:#CA8A04,stroke-width:1px
    style FinancialGoal fill:#ECFEFF,stroke:#0891B2,stroke-width:2px
    style GoalAllocation fill:#ECFEFF,stroke:#0891B2,stroke-width:1px
    style NetWorthSnapshot fill:#F3E8FF,stroke:#9333EA,stroke-width:1px
    style Notification fill:#F8FAFC,stroke:#64748B,stroke-width:1px
