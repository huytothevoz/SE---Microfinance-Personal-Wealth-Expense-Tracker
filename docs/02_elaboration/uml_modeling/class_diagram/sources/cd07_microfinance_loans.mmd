classDiagram
    direction TB

    %% ==========================================
    %% ACTORS (Tác nhân tương tác)
    %% ==========================================
    class EndUserActor {
        <<Actor: Người dùng A01>>
        +createLoan(title, type, principal, interestRate, term, walletId)
        +recordRepayment(loanId, principalPaid, interestPaid, walletId)
        +getLoanSchedule(loanId)
        +getLoans(type, status)
    }

    class SchedulerActor {
        <<Actor: Tiến trình hệ thống SYS03>>
        +triggerDailyLoanScan()
    }

    %% ==========================================
    %% BOUNDARY LAYER (Controllers & Schedulers)
    %% ==========================================
    class LoanController {
        <<Boundary>>
        +createLoan(dto: CreateLoanDTO): ResponseEntity
        +getLoans(userId: UUID, type: LoanType, status: LoanStatus): ResponseEntity
        +getLoanDetail(loanId: UUID): ResponseEntity
        +getRepaymentSchedule(loanId: UUID): ResponseEntity
        +recordRepayment(loanId: UUID, dto: RecordRepaymentDTO): ResponseEntity
    }

    class LoanReminderSchedulerJob {
        <<Boundary / Job>>
        -loanService: LoanService
        +executeDailyReminderScan(): void
    }

    %% ==========================================
    %% CONTROL LAYER (Services & Ports)
    %% ==========================================
    class LoanService {
        <<Control>>
        -loanDAO: LoanDAO
        -scheduleDAO: RepaymentScheduleDAO
        -repaymentLogDAO: LoanRepaymentLogDAO
        -ledgerPort: ILoanLedgerPort
        -walletPort: ILoanWalletPort
        -notificationPort: ILoanNotificationPort
        +createLoan(userId: UUID, dto: CreateLoanDTO): Loan
        +recordRepayment(userId: UUID, loanId: UUID, dto: RecordRepaymentDTO): RepaymentReceiptVO
        +generateAmortizationSchedule(loan: Loan): List~RepaymentScheduleItem~
        +scanUpcomingDueLoans(): void
    }

    class ILoanLedgerPort {
        <<Port / Interface>>
        +postLoanDisbursement(userId: UUID, loanId: UUID, type: LoanType, amount: BigDecimal, walletId: UUID): UUID
        +postBorrowingRepayment(userId: UUID, loanId: UUID, principal: BigDecimal, interest: BigDecimal, walletId: UUID): UUID
        +postLendingCollection(userId: UUID, loanId: UUID, principal: BigDecimal, interest: BigDecimal, walletId: UUID): UUID
    }

    class ILoanWalletPort {
        <<Port / Interface>>
        +checkBalance(walletId: UUID, requiredAmount: BigDecimal): boolean
        +applyBalanceDelta(walletId: UUID, delta: BigDecimal): void
    }

    class ILoanNotificationPort {
        <<Port / Interface>>
        +sendDueReminder(userId: UUID, loanId: UUID, title: String, daysLeft: int, dueAmount: BigDecimal): void
        +sendPaidOffNotice(userId: UUID, loanId: UUID, title: String): void
    }

    %% ==========================================
    %% ENTITY LAYER (Domain Entities & Value Objects)
    %% ==========================================
    class Loan {
        <<Entity>>
        -id: UUID
        -userId: UUID
        -title: String
        -counterparty: String
        -loanType: LoanType
        -principalAmount: BigDecimal
        -remainingPrincipal: BigDecimal
        -interestRateYear: double
        -termMonths: int
        -startDate: Date
        -dueDate: Date
        -status: LoanStatus
        -disbursedWalletId: UUID
        -createdAt: Timestamp
        +applyRepayment(principalPaid: BigDecimal): void
        +isPaidOff(): boolean
        +calculateMonthlyInstallment(): BigDecimal
        +isActive(): boolean
    }

    class RepaymentScheduleItem {
        <<Entity>>
        -id: UUID
        -loanId: UUID
        -periodNumber: int
        -dueDate: Date
        -principalDue: BigDecimal
        -interestDue: BigDecimal
        -totalDue: BigDecimal
        -principalPaid: BigDecimal
        -interestPaid: BigDecimal
        -status: RepaymentStatus
        +recordPayment(principal: BigDecimal, interest: BigDecimal): void
        +isSettled(): boolean
    }

    class RepaymentReceiptVO {
        <<ValueObject>>
        +repaymentId: UUID
        +loanId: UUID
        +paymentDate: Date
        +principalPaid: BigDecimal
        +interestPaid: BigDecimal
        +totalPaid: BigDecimal
        +newRemainingPrincipal: BigDecimal
        +isFullyPaid: boolean
    }

    class LoanType {
        <<Enumeration>>
        BORROWING
        LENDING
    }

    class LoanStatus {
        <<Enumeration>>
        ACTIVE
        PAID_OFF
        DEFAULTED
        OVERDUE
    }

    class RepaymentStatus {
        <<Enumeration>>
        PENDING
        PARTIAL
        PAID
        OVERDUE
    }

    %% ==========================================
    %% DATA ACCESS LAYER (DAOs)
    %% ==========================================
    class LoanDAO {
        <<DataAccess>>
        +save(loan: Loan): Loan
        +findById(id: UUID): Optional~Loan~
        +findWithLock(id: UUID): Optional~Loan~
        +findByUserAndType(userId: UUID, type: LoanType, status: LoanStatus): List~Loan~
        +updateRemainingPrincipalAndStatus(id: UUID, remaining: BigDecimal, status: LoanStatus): void
        +findUpcomingDueLoans(daysThreshold: int): List~Loan~
    }

    class RepaymentScheduleDAO {
        <<DataAccess>>
        +saveBatch(items: List~RepaymentScheduleItem~): void
        +findByLoanId(loanId: UUID): List~RepaymentScheduleItem~
        +findUpcomingInstallments(daysThreshold: int): List~RepaymentScheduleItem~
        +updateStatus(id: UUID, status: RepaymentStatus, principalPaid: BigDecimal, interestPaid: BigDecimal): void
    }

    class LoanRepaymentLogDAO {
        <<DataAccess>>
        +saveRepaymentRecord(loanId: UUID, principal: BigDecimal, interest: BigDecimal, walletId: UUID, txId: UUID): UUID
        +findByLoanId(loanId: UUID): List~RepaymentReceiptVO~
    }

    %% ==========================================
    %% RELATIONSHIPS
    %% ==========================================
    EndUserActor --> LoanController : quản lý vay nợ và trả góp
    SchedulerActor --> LoanReminderSchedulerJob : kích hoạt quét nhắc nợ định kỳ

    LoanController --> LoanService : ủy quyền xử lý nghiệp vụ
    LoanReminderSchedulerJob --> LoanService : kích hoạt quét lịch đến hạn

    LoanService ..> ILoanLedgerPort : hạch toán kế toán kép Nợ/Có
    LoanService ..> ILoanWalletPort : thẩm định và biến động số dư ví
    LoanService ..> ILoanNotificationPort : đẩy thông báo nhắc nợ
    LoanService --> LoanDAO : thao tác dữ liệu khoản vay
    LoanService --> RepaymentScheduleDAO : tạo và cập nhật lịch trả nợ
    LoanService --> LoanRepaymentLogDAO : ghi nhật ký thanh toán từng kỳ

    LoanService ..> Loan : quản lý vòng đời thực thể
    LoanService ..> RepaymentReceiptVO : sinh chứng từ thanh toán

    Loan *-- RepaymentScheduleItem : chứa danh sách kỳ hạn trả góp
    Loan --> LoanType : phân định Đi vay hoặc Cho vay
    Loan --> LoanStatus : quản lý trạng thái nợ
    RepaymentScheduleItem --> RepaymentStatus : trạng thái thanh toán kỳ

    LoanDAO ..> Loan : ánh xạ CSDL bảng loans
    RepaymentScheduleDAO ..> RepaymentScheduleItem : ánh xạ CSDL bảng loan_repayment_schedules

    %% ==========================================
    %% STYLES & HIGHLIGHTS
    %% ==========================================
    style LoanController fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style LoanReminderSchedulerJob fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style LoanService fill:#FEF3C7,stroke:#D97706,stroke-width:2px
    style ILoanLedgerPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style ILoanWalletPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style ILoanNotificationPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style Loan fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style RepaymentScheduleItem fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style RepaymentReceiptVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style LoanType fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style LoanStatus fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style RepaymentStatus fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style LoanDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
    style RepaymentScheduleDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
    style LoanRepaymentLogDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
