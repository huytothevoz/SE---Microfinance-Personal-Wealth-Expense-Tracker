classDiagram
    direction TB

    %% ==========================================
    %% ACTORS (Tác nhân tương tác)
    %% ==========================================
    class EndUserActor {
        <<Actor: Người dùng A01>>
        +createGoal(name, targetAmount, targetDate, walletId, priority)
        +allocateFunds(goalId, amount, walletId)
        +withdrawFunds(goalId, amount, walletId)
        +getGoals(status)
    }

    %% ==========================================
    %% BOUNDARY LAYER (Controllers)
    %% ==========================================
    class GoalController {
        <<Boundary>>
        +createGoal(dto: CreateGoalDTO): ResponseEntity
        +allocateFunds(goalId: UUID, dto: AllocateFundsDTO): ResponseEntity
        +withdrawFunds(goalId: UUID, dto: WithdrawFundsDTO): ResponseEntity
        +getGoals(userId: UUID, status: GoalStatus): ResponseEntity
        +getGoalDetail(goalId: UUID): ResponseEntity
    }

    %% ==========================================
    %% CONTROL LAYER (Services & Ports)
    %% ==========================================
    class GoalSavingService {
        <<Control>>
        -goalDAO: FinancialGoalDAO
        -allocationDAO: GoalAllocationDAO
        -walletPort: IGoalWalletPort
        +createGoal(userId: UUID, dto: CreateGoalDTO): FinancialGoal
        +allocateFunds(userId: UUID, goalId: UUID, dto: AllocateFundsDTO): GoalAllocationReceiptVO
        +withdrawFunds(userId: UUID, goalId: UUID, dto: WithdrawFundsDTO): GoalAllocationReceiptVO
        +calculateProgress(goal: FinancialGoal): double
        +calculateRequiredMonthlySaving(goal: FinancialGoal): BigDecimal
    }

    class IGoalWalletPort {
        <<Port / Interface>>
        +checkAvailableBalance(walletId: UUID, requiredAmount: BigDecimal): boolean
        +earmarkBalance(walletId: UUID, amount: BigDecimal): void
        +releaseEarmark(walletId: UUID, amount: BigDecimal): void
    }

    %% ==========================================
    %% ENTITY LAYER (Domain Entities & Value Objects)
    %% ==========================================
    class FinancialGoal {
        <<Entity>>
        -id: UUID
        -userId: UUID
        -goalName: String
        -targetAmount: BigDecimal
        -currentAmount: BigDecimal
        -targetDate: Date
        -linkedWalletId: UUID
        -status: GoalStatus
        -priority: GoalPriority
        -createdAt: Timestamp
        +allocate(amount: BigDecimal): void
        +withdraw(amount: BigDecimal): void
        +calculateProgress(): double
        +calculateRequiredMonthlySaving(currentDate: Date): BigDecimal
        +isReached(): boolean
    }

    class GoalAllocation {
        <<Entity>>
        -id: UUID
        -goalId: UUID
        -walletId: UUID
        -allocationType: AllocationType
        -amount: BigDecimal
        -allocatedAt: Timestamp
        -note: String
    }

    class GoalAllocationReceiptVO {
        <<ValueObject>>
        +goalId: UUID
        +walletId: UUID
        +allocatedAmount: BigDecimal
        +newCurrentAmount: BigDecimal
        +progressPercentage: double
        +status: GoalStatus
    }

    class GoalStatus {
        <<Enumeration>>
        IN_PROGRESS
        REACHED
        ABANDONED
    }

    class GoalPriority {
        <<Enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class AllocationType {
        <<Enumeration>>
        DEPOSIT
        WITHDRAWAL
    }

    %% ==========================================
    %% DATA ACCESS LAYER (DAOs)
    %% ==========================================
    class FinancialGoalDAO {
        <<DataAccess>>
        +save(goal: FinancialGoal): FinancialGoal
        +findById(id: UUID): Optional~FinancialGoal~
        +findWithLock(id: UUID): Optional~FinancialGoal~
        +findByUserAndStatus(userId: UUID, status: GoalStatus): List~FinancialGoal~
        +updateCurrentAmountAndStatus(id: UUID, current: BigDecimal, status: GoalStatus): void
    }

    class GoalAllocationDAO {
        <<DataAccess>>
        +save(allocation: GoalAllocation): GoalAllocation
        +findByGoalId(goalId: UUID): List~GoalAllocation~
    }

    %% ==========================================
    %% RELATIONSHIPS
    %% ==========================================
    EndUserActor --> GoalController : thiết lập và nạp quỹ mục tiêu

    GoalController --> GoalSavingService : ủy quyền xử lý nghiệp vụ tích lũy
    GoalSavingService ..> IGoalWalletPort : khóa quỹ Earmarking tại ví tài sản
    GoalSavingService --> FinancialGoalDAO : thao tác dữ liệu mục tiêu
    GoalSavingService --> GoalAllocationDAO : lưu lịch sử nạp rút quỹ

    GoalSavingService ..> FinancialGoal : quản lý vòng đời mục tiêu
    GoalSavingService ..> GoalAllocationReceiptVO : sinh biên lai phân bổ

    FinancialGoal *-- GoalAllocation : lịch sử các đợt phân bổ vốn
    FinancialGoal --> GoalStatus : quản lý tiến trình hoàn thành
    FinancialGoal --> GoalPriority : mức độ ưu tiên tích lũy
    GoalAllocation --> AllocationType : phân biệt nạp hoặc giải phóng quỹ

    FinancialGoalDAO ..> FinancialGoal : ánh xạ CSDL bảng financial_goals
    GoalAllocationDAO ..> GoalAllocation : ánh xạ CSDL bảng goal_allocations

    %% ==========================================
    %% STYLES & HIGHLIGHTS
    %% ==========================================
    style GoalController fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style GoalSavingService fill:#FEF3C7,stroke:#D97706,stroke-width:2px
    style IGoalWalletPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style FinancialGoal fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style GoalAllocation fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style GoalAllocationReceiptVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style GoalStatus fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style GoalPriority fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style AllocationType fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style FinancialGoalDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
    style GoalAllocationDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
