classDiagram
    direction TB

    %% ==========================================
    %% ACTORS (Tác nhân tương tác)
    %% ==========================================
    class EndUserActor {
        <<Actor: Người dùng A01>>
        +viewNetWorthDashboard()
        +viewCashFlowAndSavingRate(month)
        +viewNetWorthTrend(range)
        +viewFinancialHealthScore()
    }

    class SchedulerActor {
        <<Actor: Tiến trình hệ thống SYS03>>
        +triggerMidnightSnapshotSweep()
    }

    %% ==========================================
    %% BOUNDARY LAYER (Controllers & Scheduler Jobs)
    %% ==========================================
    class AnalyticsDashboardController {
        <<Boundary>>
        +getNetWorthOverview(userId: UUID): ResponseEntity
        +getNetWorthTrend(userId: UUID, startDate: Date, endDate: Date): ResponseEntity
        +getCashFlowAnalysis(userId: UUID, month: YearMonth): ResponseEntity
        +getFinancialHealthScorecard(userId: UUID): ResponseEntity
    }

    class DailySnapshotSchedulerJob {
        <<Boundary / Job>>
        -analyticsService: NetWorthAnalyticsService
        +executeMidnightSnapshotSweep(): void
    }

    %% ==========================================
    %% CONTROL LAYER (Services & Ports)
    %% ==========================================
    class NetWorthAnalyticsService {
        <<Control>>
        -snapshotDAO: NetWorthSnapshotDAO
        -assetPort: ISnapshotAssetPort
        -liabilityPort: ISnapshotLiabilityPort
        -ledgerPort: ISnapshotLedgerPort
        +computeCurrentNetWorth(userId: UUID): NetWorthBreakdownVO
        +computeCashFlowAndSavingRate(userId: UUID, month: YearMonth): CashFlowReportVO
        +evaluateFinancialHealth(userId: UUID): FinancialHealthScoreVO
        +captureDailySnapshot(userId: UUID, date: Date): NetWorthSnapshot
        +captureAllActiveUsersSnapshot(date: Date): int
    }

    class ISnapshotAssetPort {
        <<Port / Interface>>
        +getTotalWalletAssets(userId: UUID): BigDecimal
        +getTotalGoldValuation(userId: UUID): BigDecimal
    }

    class ISnapshotLiabilityPort {
        <<Port / Interface>>
        +getTotalCreditCardDebts(userId: UUID): BigDecimal
        +getTotalActiveLoanPrincipal(userId: UUID): BigDecimal
    }

    class ISnapshotLedgerPort {
        <<Port / Interface>>
        +getMonthlyTotalIncome(userId: UUID, month: YearMonth): BigDecimal
        +getMonthlyTotalExpense(userId: UUID, month: YearMonth): BigDecimal
    }

    %% ==========================================
    %% ENTITY LAYER (Domain Entities & Value Objects)
    %% ==========================================
    class NetWorthSnapshot {
        <<Entity>>
        -id: UUID
        -userId: UUID
        -snapshotDate: Date
        -totalAssets: BigDecimal
        -totalLiabilities: BigDecimal
        -netWorth: BigDecimal
        -walletAssetsAmount: BigDecimal
        -goldAssetsAmount: BigDecimal
        -creditDebtAmount: BigDecimal
        -loanDebtAmount: BigDecimal
        -createdAt: Timestamp
        +calculateNetWorth(): BigDecimal
    }

    class NetWorthBreakdownVO {
        <<ValueObject>>
        +totalAssets: BigDecimal
        +totalLiabilities: BigDecimal
        +netWorth: BigDecimal
        +walletAssetsTotal: BigDecimal
        +goldAssetsTotal: BigDecimal
        +creditDebtTotal: BigDecimal
        +loanDebtTotal: BigDecimal
    }

    class CashFlowReportVO {
        <<ValueObject>>
        +month: YearMonth
        +totalIncome: BigDecimal
        +totalExpense: BigDecimal
        +netCashFlow: BigDecimal
        +savingRate: Double
        +savingRateStatus: SavingRateStatus
    }

    class FinancialHealthScoreVO {
        <<ValueObject>>
        +overallScore: int
        +healthRating: HealthRating
        +debtToIncomeRatio: double
        +liquidityMonths: double
        +savingRate: Double
        +recommendations: List~String~'
    }

    class HealthRating {
        <<Enumeration>>
        EXCELLENT
        GOOD
        FAIR
        CRITICAL
    }

    class SavingRateStatus {
        <<Enumeration>>
        POSITIVE
        DEFICIT
        NOT_APPLICABLE
    }

    %% ==========================================
    %% DATA ACCESS LAYER (DAOs)
    %% ==========================================
    class NetWorthSnapshotDAO {
        <<DataAccess>>
        +save(snapshot: NetWorthSnapshot): NetWorthSnapshot
        +findByDate(userId: UUID, date: Date): Optional~NetWorthSnapshot~
        +findTrendByRange(userId: UUID, startDate: Date, endDate: Date): List~NetWorthSnapshot~
        +getLatestSnapshot(userId: UUID): Optional~NetWorthSnapshot~
        +saveBatchSnapshots(snapshots: List~NetWorthSnapshot~): void
    }

    %% ==========================================
    %% RELATIONSHIPS
    %% ==========================================
    EndUserActor --> AnalyticsDashboardController : tra cứu dashboard tài chính
    SchedulerActor --> DailySnapshotSchedulerJob : kích hoạt chụp snapshot 23h59

    AnalyticsDashboardController --> NetWorthAnalyticsService : yêu cầu tính toán chỉ số
    DailySnapshotSchedulerJob --> NetWorthAnalyticsService : kích hoạt quét chụp dữ liệu nền

    NetWorthAnalyticsService ..> ISnapshotAssetPort : tổng hợp tài sản ví và vàng
    NetWorthAnalyticsService ..> ISnapshotLiabilityPort : tổng hợp nợ thẻ và vay vi mô
    NetWorthAnalyticsService ..> ISnapshotLedgerPort : tổng hợp dòng tiền thu chi
    NetWorthAnalyticsService --> NetWorthSnapshotDAO : lưu và truy vấn chuỗi snapshot

    NetWorthAnalyticsService ..> NetWorthSnapshot : sinh bản ghi snapshot bất biến
    NetWorthAnalyticsService ..> NetWorthBreakdownVO : tổng hợp cơ cấu tài sản
    NetWorthAnalyticsService ..> CashFlowReportVO : báo cáo dòng tiền và saving rate
    NetWorthAnalyticsService ..> FinancialHealthScoreVO : báo cáo thang điểm sức khỏe

    FinancialHealthScoreVO --> HealthRating : mức xếp hạng sức khỏe
    CashFlowReportVO --> SavingRateStatus : trạng thái tỷ lệ tiết kiệm

    NetWorthSnapshotDAO ..> NetWorthSnapshot : ánh xạ CSDL bảng net_worth_snapshots

    %% ==========================================
    %% STYLES & HIGHLIGHTS
    %% ==========================================
    style AnalyticsDashboardController fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style DailySnapshotSchedulerJob fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style NetWorthAnalyticsService fill:#FEF3C7,stroke:#D97706,stroke-width:2px
    style ISnapshotAssetPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style ISnapshotLiabilityPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style ISnapshotLedgerPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style NetWorthSnapshot fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style NetWorthBreakdownVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style CashFlowReportVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style FinancialHealthScoreVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style HealthRating fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style SavingRateStatus fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style NetWorthSnapshotDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
