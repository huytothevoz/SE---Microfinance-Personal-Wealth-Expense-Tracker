    %% ==========================================
    style GoldController fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style GoldPriceSyncSchedulerJob fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style GoldAssetService fill:#FEF3C7,stroke:#D97706,stroke-width:2px
    style IGoldLedgerPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style IGoldPriceFeedPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style GoldHolding fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style GoldTransaction fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style GoldPortfolioSummaryVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style GoldSaleReceiptVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style GoldPriceSnapshotVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style GoldType fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style GoldTxType fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style GoldHoldingDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
    style GoldTransactionDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
    style GoldPriceDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
