classDiagram
    direction TB

    %% ==========================================
    %% ACTORS (Tác nhân tương tác)
    %% ==========================================
    class EndUserActor {
        <<Actor: Người dùng A01>>
        +createBudget(categoryId, month, limitAmount)
        +updateBudget(budgetId, newLimit)
        +deleteBudget(budgetId)
        +getBudgets(month)
    }

    class SchedulerActor {
        <<Actor: Tiến trình hệ thống SYS03>>
        +triggerPeriodicBudgetCheck()
    }

    %% ==========================================
    %% BOUNDARY LAYER (Controllers & Scheduler Jobs)
    %% ==========================================
    class BudgetController {
        <<Boundary>>
        +createBudget(dto: CreateBudgetDTO): ResponseEntity
        +getBudgets(userId: UUID, month: YearMonth): ResponseEntity
        +getBudgetDetail(budgetId: UUID): ResponseEntity
        +updateBudget(budgetId: UUID, dto: UpdateBudgetDTO): ResponseEntity
        +deleteBudget(budgetId: UUID): ResponseEntity
        +getBudgetSummary(userId: UUID, month: YearMonth): ResponseEntity
    }

    class BudgetCheckSchedulerJob {
        <<Boundary / Job>>
        -budgetService: BudgetService
        +executeDailyBudgetSweep(): void
    }

    %% ==========================================
    %% CONTROL LAYER (Services & Ports)
    %% ==========================================
    class BudgetService {
        <<Control>>
        -budgetDAO: BudgetDAO
        -ledgerPort: IBudgetLedgerPort
        -notificationPort: IBudgetNotificationPort
        +createBudget(userId: UUID, dto: CreateBudgetDTO): Budget
        +updateBudgetLimit(userId: UUID, budgetId: UUID, newLimit: BigDecimal): Budget
        +deleteBudget(userId: UUID, budgetId: UUID): void
        +getBudgetsWithProgress(userId: UUID, month: YearMonth): List~BudgetUsageVO~
        +evaluateBudgetUsage(userId: UUID, categoryId: UUID, month: YearMonth): BudgetUsageVO
        +checkAndNotifyBudgetAlert(budget: Budget, netExpense: BigDecimal): void
    }

    class IBudgetLedgerPort {
        <<Port / Interface>>
        +getMonthlyCategoryNetExpense(userId: UUID, categoryId: UUID, month: YearMonth): BigDecimal
    }

    class IBudgetNotificationPort {
        <<Port / Interface>>
        +sendBudgetAlert(userId: UUID, categoryId: UUID, alertLevel: BudgetAlertLevel, percentage: double, spent: BigDecimal, limit: BigDecimal): void
    }

    %% ==========================================
    %% ENTITY LAYER (Domain Entities & Value Objects)
    %% ==========================================
    class Budget {
        <<Entity>>
        -id: UUID
        -userId: UUID
        -categoryId: UUID
        -month: YearMonth
        -limitAmount: BigDecimal
        -spentAmount: BigDecimal
        -status: BudgetStatus
        -alertLevel: BudgetAlertLevel
        -isYellowAlertSent: boolean
        -isRedAlertSent: boolean
        -createdAt: Timestamp
        -updatedAt: Timestamp
        +calculateUsage(): double
        +updateSpent(newSpent: BigDecimal): void
        +evaluateAlertLevel(percentage: double): BudgetAlertLevel
        +markYellowAlertSent(): void
        +markRedAlertSent(): void
        +resetAlertState(): void
        +isOverBudget(): boolean
        +isActive(): boolean
    }

    class BudgetUsageVO {
        <<ValueObject>>
        +categoryId: UUID
        +categoryName: String
        +month: YearMonth
        +limitAmount: BigDecimal
        +spentAmount: BigDecimal
        +remainingAmount: BigDecimal
        +usagePercentage: double
        +alertLevel: BudgetAlertLevel
        +isOverBudget: boolean
    }

    class BudgetStatus {
        <<Enumeration>>
        ACTIVE
        EXPIRED
        ARCHIVED
    }

    class BudgetAlertLevel {
        <<Enumeration>>
        NORMAL
        YELLOW_80
        RED_100
    }

    %% ==========================================
    %% DATA ACCESS LAYER (DAOs)
    %% ==========================================
    class BudgetDAO {
        <<DataAccess>>
        +save(budget: Budget): Budget
        +findById(id: UUID): Optional~Budget~
        +findByCategoryAndMonth(userId: UUID, categoryId: UUID, month: YearMonth): Optional~Budget~
        +findByUserAndMonth(userId: UUID, month: YearMonth): List~Budget~
        +updateSpentAndAlerts(id: UUID, spent: BigDecimal, level: BudgetAlertLevel, yellowSent: boolean, redSent: boolean): void
        +deleteById(id: UUID): boolean
        +existsByCategoryAndMonth(userId: UUID, categoryId: UUID, month: YearMonth): boolean
    }

    %% ==========================================
    %% RELATIONSHIPS
    %% ==========================================
    EndUserActor --> BudgetController : tương tác UI thiết lập hạn mức
    SchedulerActor --> BudgetCheckSchedulerJob : kích hoạt định kỳ

    BudgetController --> BudgetService : gọi xử lý nghiệp vụ
    BudgetCheckSchedulerJob --> BudgetService : kích hoạt quét đối soát

    BudgetService ..> IBudgetLedgerPort : truy vấn chi tiêu ròng sổ cái
    BudgetService ..> IBudgetNotificationPort : phát thông báo cảnh báo 80% hoặc 100%
    BudgetService --> BudgetDAO : thực thi truy vấn và lưu trạng thái CSDL
    BudgetService ..> Budget : tạo mới hoặc cập nhật thực thể
    BudgetService ..> BudgetUsageVO : đóng gói kết quả phản hồi giao diện

    Budget --> BudgetStatus : xác định trạng thái hiệu lực
    Budget --> BudgetAlertLevel : ghi nhận cấp độ cảnh báo

    BudgetDAO ..> Budget : ánh xạ ORM bảng budgets

    %% ==========================================
    %% STYLES & HIGHLIGHTS
    %% ==========================================
    style BudgetController fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style BudgetCheckSchedulerJob fill:#E0E7FF,stroke:#4338CA,stroke-width:2px
    style BudgetService fill:#FEF3C7,stroke:#D97706,stroke-width:2px
    style IBudgetLedgerPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style IBudgetNotificationPort fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style Budget fill:#ECFDF5,stroke:#059669,stroke-width:2px
    style BudgetUsageVO fill:#F1F5F9,stroke:#64748B,stroke-width:1px
    style BudgetStatus fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style BudgetAlertLevel fill:#F8FAFC,stroke:#94A3B8,stroke-width:1px
    style BudgetDAO fill:#FCE7F3,stroke:#DB2777,stroke-width:2px
